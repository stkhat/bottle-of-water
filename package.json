{
  "name": "lingo",
  "description": "Language learning on the videos and articles you already read",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:check": "wxt build --mode check && node scripts/build-check.ts",
    "build:check-download": "wxt build --mode check-download",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:claude-md && npm run check:dead",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:manifest": "vitest run --project manifest",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build && wxt build --mode check && npm run build:check-download && playwright test",
    "test:e2e:real": "LINGO_REAL_SITES=1 playwright test e2e/extension-errors.spec.ts -g \"real sites\"",
    "test:all": "npm test && npm run test:browser",
    "verify": "npm run check && npm test -- --reporter=dot && VITEST_BROWSERS=chromium npm run test:browser -- --reporter=dot && npm run test:e2e:build -- --reporter=dot",
    "postinstall": "wxt prepare",
    "check:claude-md": "node scripts/check-claude-md.ts",
    "test:mutation": "stryker run",
    "data:build": "npm run data:ejdict && npm run data:kaikki && npm run data:freq && npm run data:phrases && npm run data:en-defs",
    "data:ejdict": "node scripts/data/ejdict.ts",
    "data:kaikki": "node scripts/data/kaikki.ts",
    "data:phrases": "node scripts/data/phrases.ts",
    "data:en-defs": "node scripts/data/en-defs.ts",
    "data:native": "node scripts/data/recipes/native.ts",
    "data:freq": "node scripts/data/frequency.ts",
    "data:es": "node scripts/data/es-frequency.ts && node scripts/data/es-kaikki.ts",
    "data:stats": "node scripts/data/stats.ts",
    "data:publish": "node scripts/data/publish.ts",
    "prepare": "simple-git-hooks",
    "check:dead": "knip"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dexie": "^4.4.7",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vitest-browser-preact": "^2.0.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run check"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write --ignore-unknown",
      "eslint --fix --no-warn-ignored"
    ],
    "!(*.{ts,tsx,js,mjs,cjs})": "prettier --write --ignore-unknown"
  },
  "knip": {
    "wxt": {
      "entry": [
        "src/entrypoints/**/*.{ts,tsx,html}",
        "!src/entrypoints/**/*.test.{ts,tsx}"
      ]
    },
    "entry": [
      "scripts/format-hook.ts",
      "scripts/icons/make-icons.ts",
      "vitest.unit.config.ts"
    ]
  }
}
