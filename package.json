{
  "name": "lingo",
  "description": "Language learning on the videos and articles you already read",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:claude-md",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:manifest": "vitest run --project manifest",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build && playwright test",
    "test:all": "npm test && npm run test:browser",
    "postinstall": "wxt prepare",
    "check:claude-md": "node scripts/check-claude-md.mjs",
    "test:mutation": "stryker run",
    "data:build": "npm run data:ejdict && npm run data:kaikki && npm run data:freq",
    "data:ejdict": "node scripts/data/ejdict.mjs",
    "data:kaikki": "node scripts/data/kaikki.mjs",
    "data:freq": "node scripts/data/frequency.mjs",
    "data:stats": "node scripts/data/stats.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vitest-browser-preact": "^2.0.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
