{
  "wireMagic": "pb3",
  "pens": [{}],
  "wsWinStyles": [{}],
  "wpWinPositions": [{}],
  "events": [
    {"tStartMs":27103,"dDurationMs":2575,"segs":[{"utf8":"Good morning. How are you?"}]},
    {"tStartMs":29702,"dDurationMs":1403,"segs":[{"utf8":"(Audience) Good."}]},
    {"tStartMs":31129,"dDurationMs":1668,"segs":[{"utf8":"It's been great, hasn't it?"}]},
    {"tStartMs":33408,"dDurationMs":2321,"segs":[{"utf8":"I've been blown away by the whole thing."}]},
    {"tStartMs":35753,"dDurationMs":1492,"segs":[{"utf8":"In fact, I'm leaving."}]},
    {"tStartMs":37269,"dDurationMs":3906,"segs":[{"utf8":"(Laughter)"}]},
    {"tStartMs":43096,"dDurationMs":3567,"segs":[{"utf8":"There have been three themes\nrunning through the conference,"}]},
    {"tStartMs":46687,"dDurationMs":2286,"segs":[{"utf8":"which are relevant\nto what I want to talk about."}]},
    {"tStartMs":48997,"dDurationMs":4470,"segs":[{"utf8":"One is the extraordinary\nevidence of human creativity"}]},
    {"tStartMs":53491,"dDurationMs":2413,"segs":[{"utf8":"in all of the presentations that we've had"}]},
    {"tStartMs":55928,"dDurationMs":1952,"segs":[{"utf8":"and in all of the people here;"}]},
    {"tStartMs":57904,"dDurationMs":2651,"segs":[{"utf8":"just the variety of it\nand the range of it."}]},
    {"tStartMs":61158,"dDurationMs":2143,"segs":[{"utf8":"The second is that it's put us in a place"}]},
    {"tStartMs":63325,"dDurationMs":2497,"segs":[{"utf8":"where we have no idea\nwhat's going to happen"}]},
    {"tStartMs":65846,"dDurationMs":1391,"segs":[{"utf8":"in terms of the future."}]},
    {"tStartMs":67261,"dDurationMs":2985,"segs":[{"utf8":"No idea how this may play out."}]},
    {"tStartMs":70270,"dDurationMs":1622,"segs":[{"utf8":"I have an interest in education."}]},
    {"tStartMs":71916,"dDurationMs":4412,"segs":[{"utf8":"Actually, what I find is,\neverybody has an interest in education."}]},
    {"tStartMs":76352,"dDurationMs":1317,"segs":[{"utf8":"Don't you?"}]},
    {"tStartMs":77693,"dDurationMs":1402,"segs":[{"utf8":"I find this very interesting."}]},
    {"tStartMs":79119,"dDurationMs":3958,"segs":[{"utf8":"If you're at a dinner party,\nand you say you work in education --"}]},
    {"tStartMs":83101,"dDurationMs":2745,"segs":[{"utf8":"actually, you're not often\nat dinner parties, frankly."}]},
    {"tStartMs":85870,"dDurationMs":3796,"segs":[{"utf8":"(Laughter)"}]},
    {"tStartMs":89690,"dDurationMs":2428,"segs":[{"utf8":"If you work in education,\nyou're not asked."}]},
    {"tStartMs":92142,"dDurationMs":3179,"segs":[{"utf8":"(Laughter)"}]},
    {"tStartMs":95345,"dDurationMs":3959,"segs":[{"utf8":"And you're never asked back, curiously.\nThat's strange to me."}]},
    {"tStartMs":99328,"dDurationMs":2216,"segs":[{"utf8":"But if you are, and you say to somebody,"}]},
    {"tStartMs":101568,"dDurationMs":1778,"segs":[{"utf8":"you know, they say, \"What do you do?\""}]},
    {"tStartMs":103370,"dDurationMs":1688,"segs":[{"utf8":"and you say you work in education,"}]},
    {"tStartMs":105082,"dDurationMs":2049,"segs":[{"utf8":"you can see the blood run from their face."}]},
    {"tStartMs":107155,"dDurationMs":1685,"segs":[{"utf8":"They're like, \"Oh my God. Why me?\""}]},
    {"tStartMs":108864,"dDurationMs":2276,"segs":[{"utf8":"(Laughter)"}]},
    {"tStartMs":111164,"dDurationMs":1524,"segs":[{"utf8":"\"My one night out all week.\""}]},
    {"tStartMs":112712,"dDurationMs":2610,"segs":[{"utf8":"(Laughter)"}]},
    {"tStartMs":115346,"dDurationMs":3241,"segs":[{"utf8":"But if you ask about their education,\nthey pin you to the wall,"}]},
    {"tStartMs":118611,"dDurationMs":3407,"segs":[{"utf8":"because it's one of those things\nthat goes deep with people, am I right?"}]},
    {"tStartMs":122042,"dDurationMs":3493,"segs":[{"utf8":"Like religion and money and other things."}]},
    {"tStartMs":125559,"dDurationMs":4442,"segs":[{"utf8":"So I have a big interest in education,\nand I think we all do."}]},
    {"tStartMs":130025,"dDurationMs":1802,"segs":[{"utf8":"We have a huge vested interest in it,"}]},
    {"tStartMs":131851,"dDurationMs":3320,"segs":[{"utf8":"partly because it's education\nthat's meant to take us into this future"}]}
  ]
}
