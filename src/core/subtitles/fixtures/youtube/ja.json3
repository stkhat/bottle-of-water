{
  "wireMagic": "pb3",
  "pens": [{}],
  "wsWinStyles": [{}],
  "wpWinPositions": [{}],
  "events": [
    {"tStartMs":0,"dDurationMs":7000,"segs":[{"utf8":"翻訳: Naho Iguchi\n校正: Miwa Nakamura"}]},
    {"tStartMs":25000,"dDurationMs":7000,"segs":[{"utf8":"おはようございます。気分はいかがですか？素晴らしいですね、ここは"}]},
    {"tStartMs":32000,"dDurationMs":4000,"segs":[{"utf8":"すべてが驚嘆の連続です"}]},
    {"tStartMs":36000,"dDurationMs":4000,"segs":[{"utf8":"だからそろそろ帰ろうかと思って（笑）"}]},
    {"tStartMs":40000,"dDurationMs":4000,"segs":[{"utf8":"カンファレンスを通して、これまで私たちは"}]},
    {"tStartMs":44000,"dDurationMs":4000,"segs":[{"utf8":"３つのテーマを取り上げてきました"}]},
    {"tStartMs":48000,"dDurationMs":2000,"segs":[{"utf8":"どれも私が話したいことに関わっています"}]},
    {"tStartMs":50000,"dDurationMs":4000,"segs":[{"utf8":"１つ目は人間の創造性について"}]},
    {"tStartMs":54000,"dDurationMs":3000,"segs":[{"utf8":"ここにいるすべての人が持っている"}]},
    {"tStartMs":57000,"dDurationMs":3000,"segs":[{"utf8":"様々な形で表れる私たちの創造性と"}]},
    {"tStartMs":60000,"dDurationMs":3000,"segs":[{"utf8":"その幅の広さです。２つ目は"}]},
    {"tStartMs":63000,"dDurationMs":3000,"segs":[{"utf8":"創造性は未来に一体何が起こるのかを"}]},
    {"tStartMs":66000,"dDurationMs":2000,"segs":[{"utf8":"予測不可能にしてしまいます"}]},
    {"tStartMs":68000,"dDurationMs":2000,"segs":[{"utf8":"次に何が起こるかなんてさっぱりわからない"}]},
    {"tStartMs":70000,"dDurationMs":3000,"segs":[{"utf8":"私は教育に関心があります"}]},
    {"tStartMs":73000,"dDurationMs":3000,"segs":[{"utf8":"実際誰もが教育に関心があるんです"}]},
    {"tStartMs":76000,"dDurationMs":2000,"segs":[{"utf8":"あるでしょう？私はとっても興味がある"}]},
    {"tStartMs":78000,"dDurationMs":3000,"segs":[{"utf8":"例えばディナーパーティーの席で"}]},
    {"tStartMs":81000,"dDurationMs":3000,"segs":[{"utf8":"あなたが教育関係の仕事をしてると言ったとします"}]},
    {"tStartMs":84000,"dDurationMs":7000,"segs":[{"utf8":"まあ実のところ、教育関係で働いている人はあまりディナーパーティーに行ったりしません"}]},
    {"tStartMs":91000,"dDurationMs":3000,"segs":[{"utf8":"そんなに誘われませんよね"}]},
    {"tStartMs":94000,"dDurationMs":5000,"segs":[{"utf8":"まったく誘われない。どうしてでしょうね"}]},
    {"tStartMs":99000,"dDurationMs":2000,"segs":[{"utf8":"でも招待されて、誰かと話すとします"}]},
    {"tStartMs":101000,"dDurationMs":2000,"segs":[{"utf8":"「お仕事は？」と聞かれ"}]},
    {"tStartMs":103000,"dDurationMs":2000,"segs":[{"utf8":"「教育関連の仕事です」と答えると"}]},
    {"tStartMs":105000,"dDurationMs":4000,"segs":[{"utf8":"彼らの顔から血の気が引くんです。きっと心の中で"}]},
    {"tStartMs":109000,"dDurationMs":6000,"segs":[{"utf8":"「なんてこった！なんで私の隣に？せっかくのパーティーなのに！」なんて思ってる"}]},
    {"tStartMs":115000,"dDurationMs":2000,"segs":[{"utf8":"でもあなたが彼らの受けた教育について聞いたら"}]},
    {"tStartMs":117000,"dDurationMs":2000,"segs":[{"utf8":"彼らは熱心に話し出すでしょう。教育というのは"}]},
    {"tStartMs":119000,"dDurationMs":3000,"segs":[{"utf8":"深い問題ですからね。そうでしょ？"}]},
    {"tStartMs":122000,"dDurationMs":3000,"segs":[{"utf8":"宗教やお金のことみたいに"}]},
    {"tStartMs":125000,"dDurationMs":4000,"segs":[{"utf8":"私は教育に非常に関心があります。私たちは皆"}]},
    {"tStartMs":129000,"dDurationMs":2000,"segs":[{"utf8":"教育に大きな関心があると思います"}]},
    {"tStartMs":131000,"dDurationMs":3000,"segs":[{"utf8":"恐らく教育というものが私たちを予測不能な未来へと"}]},
    {"tStartMs":134000,"dDurationMs":3000,"segs":[{"utf8":"運んで行くからでしょう"}]}
  ]
}
