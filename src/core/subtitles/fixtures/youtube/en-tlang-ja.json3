{
  "wireMagic": "pb3",
  "pens": [{}],
  "wsWinStyles": [{}],
  "wpWinPositions": [{}],
  "events": [
    {"tStartMs":27103,"dDurationMs":2575,"segs":[{"utf8":"おはよう。 元気ですか？"}]},
    {"tStartMs":29702,"dDurationMs":1403,"segs":[{"utf8":"（聴衆）いいですね。"}]},
    {"tStartMs":31129,"dDurationMs":1668,"segs":[{"utf8":"最高だったよね？"}]},
    {"tStartMs":33408,"dDurationMs":2321,"segs":[{"utf8":"全てに圧倒されました。"}]},
    {"tStartMs":35753,"dDurationMs":1492,"segs":[{"utf8":"実は、私はここを去ります。"}]},
    {"tStartMs":37269,"dDurationMs":3906,"segs":[{"utf8":"（笑い）今回の"}]},
    {"tStartMs":43096,"dDurationMs":3567,"segs":[{"utf8":"\n会議には、"}]},
    {"tStartMs":46687,"dDurationMs":2286,"segs":[{"utf8":"\n私がこれからお話ししたいことに関連する3つのテーマがありました。"}]},
    {"tStartMs":48997,"dDurationMs":4470,"segs":[{"utf8":"一つは、これまで行ってきた\n"}]},
    {"tStartMs":53491,"dDurationMs":2413,"segs":[{"utf8":"すべてのプレゼンテーションと、"}]},
    {"tStartMs":55928,"dDurationMs":1952,"segs":[{"utf8":"ここにいるすべての人々に見られる、人間の創造性の並外れた証拠です。"}]},
    {"tStartMs":57904,"dDurationMs":2651,"segs":[{"utf8":"その多様性\nと幅広さこそが魅力です。"}]},
    {"tStartMs":61158,"dDurationMs":2143,"segs":[{"utf8":"2つ目は、"}]},
    {"tStartMs":63325,"dDurationMs":2497,"segs":[{"utf8":"\n"}]},
    {"tStartMs":65846,"dDurationMs":1391,"segs":[{"utf8":"将来何が起こるか全く見当がつかない状況に陥ってしまったということです。"}]},
    {"tStartMs":67261,"dDurationMs":2985,"segs":[{"utf8":"これがどうなるかは全く見当がつかない。"}]},
    {"tStartMs":70270,"dDurationMs":1622,"segs":[{"utf8":"私は教育に興味があります。"}]},
    {"tStartMs":71916,"dDurationMs":4412,"segs":[{"utf8":"実際、私が気づいたのは、\n誰もが教育に興味を持っているということです。 そうでしょう"}]},
    {"tStartMs":76352,"dDurationMs":1317,"segs":[{"utf8":"？"}]},
    {"tStartMs":77693,"dDurationMs":1402,"segs":[{"utf8":"これは非常に興味深いですね。"}]},
    {"tStartMs":79119,"dDurationMs":3958,"segs":[{"utf8":"もしあなたがディナーパーティーに出席していて、\n教育関係の仕事をしていると発言したとしましょう。"}]},
    {"tStartMs":83101,"dDurationMs":2745,"segs":[{"utf8":"実際には、\n正直言って、あなたはディナーパーティーに出席する機会はあまりないでしょう。"}]},
    {"tStartMs":85870,"dDurationMs":3796,"segs":[{"utf8":"（笑い）"}]},
    {"tStartMs":89690,"dDurationMs":2428,"segs":[{"utf8":"教育関係の仕事をしている人は、そんなことを聞​​かれることは\nないんです。"}]},
    {"tStartMs":92142,"dDurationMs":3179,"segs":[{"utf8":"（笑）"}]},
    {"tStartMs":95345,"dDurationMs":3959,"segs":[{"utf8":"そして不思議なことに、二度と呼ばれることはないんです。\nそれは私には奇妙に思える。"}]},
    {"tStartMs":99328,"dDurationMs":2216,"segs":[{"utf8":"でも、もしあなたがそうなら、誰かに"}]},
    {"tStartMs":101568,"dDurationMs":1778,"segs":[{"utf8":"「あなたは何をしているの？」と聞かれるでしょう。"}]},
    {"tStartMs":103370,"dDurationMs":1688,"segs":[{"utf8":"あなたが教育関係の仕事をしていると言えば、"}]},
    {"tStartMs":105082,"dDurationMs":2049,"segs":[{"utf8":"彼らの顔から血の気が引くのがわかるでしょう。"}]},
    {"tStartMs":107155,"dDurationMs":1685,"segs":[{"utf8":"彼らは「なんてことだ。なぜ私なの？」という感じだ。"}]},
    {"tStartMs":108864,"dDurationMs":2276,"segs":[{"utf8":"（笑い）"}]},
    {"tStartMs":111164,"dDurationMs":1524,"segs":[{"utf8":"「今週唯一の外出だったよ。」"}]},
    {"tStartMs":112712,"dDurationMs":2610,"segs":[{"utf8":"（笑）"}]},
    {"tStartMs":115346,"dDurationMs":3241,"segs":[{"utf8":"でも、教育について尋ねると、\n彼らはあなたを壁に押し付けるようにして答えるんです。"}]},
    {"tStartMs":118611,"dDurationMs":3407,"segs":[{"utf8":"なぜなら、それは\n人々の心に深く根付く事柄の一つだからです。そうでしょう？"}]},
    {"tStartMs":122042,"dDurationMs":3493,"segs":[{"utf8":"宗教やお金、その他諸々と同じように。"}]},
    {"tStartMs":125559,"dDurationMs":4442,"segs":[{"utf8":"私は教育に大きな関心を持っていますし、おそらく誰もがそうだと\n思います。"}]},
    {"tStartMs":130025,"dDurationMs":1802,"segs":[{"utf8":"私たちにはそれに対する大きな利害関係がある。"}]},
    {"tStartMs":131851,"dDurationMs":3320,"segs":[{"utf8":"なぜなら、教育は私たちがまだ理解できない\n未来へと私たちを導くためのものだからだ"}]}
  ]
}
