<?xml version="1.0" encoding="utf-8"?>
<!--
  SYNTHETIC fixture, modeled on the real structure seen 2026-11-10 (a Japanese subtitles
  track, profile imsc1.1, of a title on netflix.com). The markup follows what was seen:
  tick times at 10,000,000 ticks a second, xml:lang="ja", xml:space="preserve" on <p>,
  ruby declared on <style> elements (tts:ruby container / base / text) that spans refer
  to by id, a vertical region (tts:writingMode) and a sheared style (tts:shear). Its line
  breaks and times differ from en.dfxp, as Netflix's Japanese subtitles do. The text is
  made up.
-->
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttp="http://www.w3.org/ns/ttml#parameter" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:ittp="http://www.w3.org/ns/ttml/profile/imsc1#parameter" ttp:profile="http://www.w3.org/ns/ttml/profile/imsc1.1/text" ttp:tickRate="10000000" ttp:timeBase="media" ittp:aspectRatio="16 9" xml:lang="ja">
  <head>
    <styling>
      <style xml:id="style0" tts:color="white" tts:fontFamily="proportionalSansSerif" tts:fontSize="100%" tts:textAlign="center"/>
      <style xml:id="style1" tts:color="white" tts:fontFamily="proportionalSansSerif" tts:fontSize="100%" tts:textAlign="center" tts:writingMode="tbrl"/>
      <style xml:id="style2" tts:shear="16.6667%"/>
      <style xml:id="style5" tts:ruby="container"/>
      <style xml:id="style6" tts:ruby="base"/>
      <style xml:id="style7" tts:ruby="text" tts:rubyPosition="before"/>
    </styling>
    <layout>
      <region xml:id="region0" tts:displayAlign="after" tts:extent="80.00% 80.00%" tts:origin="10.00% 10.00%"/>
      <region xml:id="region1" tts:displayAlign="before" tts:extent="10.00% 80.00%" tts:origin="85.00% 10.00%" tts:writingMode="tbrl"/>
    </layout>
  </head>
  <body>
    <div>
      <p begin="8800000t" end="80000000t" region="region0" style="style0" xml:space="preserve">こんばんは ワークショップへようこそ<br/>今夜のテーマは教室での<span style="style5"><span style="style6">創造性</span><span style="style7">そうぞうせい</span></span>です</p>
      <p begin="83800000t" end="120000000t" region="region0" style="style0" xml:space="preserve">子どもは皆 驚くべき<span style="style5"><span style="style6">想像力</span><span style="style7">そうぞうりょく</span></span>を持っています</p>
      <p begin="123800000t" end="160000000t" region="region0" style="style0" xml:space="preserve">それを押しつぶさず 育てるべきです</p>
      <p begin="163800000t" end="200000000t" region="region1" style="style1" xml:space="preserve">（拍手）</p>
      <p begin="203800000t" end="240000000t" region="region0" style="style0" xml:space="preserve"><span style="style2">間違いは学びの一部です</span></p>
      <p begin="243800000t" end="320000000t" region="region0" style="style0" xml:space="preserve">間違う覚悟がなければ<br/>独創的なものは生まれません</p>
      <p begin="323800000t" end="360000000t" region="region0" style="style0" xml:space="preserve">“それが問題の核心です”</p>
      <p begin="363800000t" end="400000000t" region="region0" style="style0" xml:space="preserve">ありがとう</p>
    </div>
  </body>
</tt>
