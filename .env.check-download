# `wxt build --mode check-download` (npm run build:check-download): the check build,
# except that its language data is downloaded from the E2E server's local npm mirror
# (e2e/serve.ts, which pack-downloads.spec.ts can make fail or wait) instead of the
# lock's mirrors. WXT reads .env.<mode> files; the override applies in any mode but
# production (src/core/packs/lock.ts).
WXT_PACK_MIRRORS=http://localhost:4719/mirror/{package}@{version}/{file}
