# `wxt build --mode check-download` (npm run build:check-download): the check build,
# except that Spanish data is downloaded from the E2E server's local npm mirror
# (e2e/serve.mjs) instead of bundled. WXT reads .env.<mode> files; the overrides apply
# in any mode but production (src/core/packs/lock.ts).
WXT_PACKS_DOWNLOAD=es,es-en
WXT_PACK_MIRRORS=http://localhost:4719/mirror/{package}@{version}/{file}
